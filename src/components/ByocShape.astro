---
interface Props {
    inputName: string;
    value: string;
    icon: string;
    label: string;
}

const { inputName, value, icon, label } = Astro.props;
---

<input
    type="radio"
    name={inputName}
    id={`shape-${value}`}
    value={value}
    class="byoc__radio byoc__radio--shape"
/>
<label for={`shape-${value}`} class="byoc__shape-label">
    <img src={icon} alt={label} class="byoc__icon" />
    <span>{label}</span>
</label>
