---
import { Image } from "astro:assets";
import { getI18N } from "../utils/i18n";
import type { Lang } from "../utils/i18n";
import MascotPopover from "./MascotPopover.astro";
import MascotTrigger from "./MascotTrigger.astro";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const { global } = getI18N(lang);
---

<MascotPopover lang={lang} />
<MascotTrigger id="mascot-popover" ctaText={global.mascot_cta_text} />

<a
    href="#build-your-own"
    class="mobile-byoc-btn"
    aria-label={global.mascot_cta_text}
>
    <Image
        src="/uploads/icons/cake-variant.svg"
        alt={global.mascot_cta_text}
        width={28}
        height={28}
        loading="eager"
    />
</a>

<script is:inline>
    const mascotPopover = document.getElementById("mascot-popover");
    if (mascotPopover) mascotPopover.showPopover();
</script>
