---
import { getI18N } from "../utils/i18n";
import type { Lang } from "../utils/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const { contacts, global } = getI18N(lang);
---

<footer
    class="flex flex-col items-center bg-text-title text-bg-main"
    id="contacts"
>
    <div
        class="flex flex-col items-center gap-[clamp(0.75rem,2vw,1.25rem)] text-center px-[clamp(1.5rem,5vw,3rem)] py-[clamp(3rem,6vw,5rem)] w-full box-border"
    >
        <h2
            class="font-accent text-[clamp(1.75rem,calc(5vw+0.5rem),3rem)] text-bg-main"
        >
            {global.nav_contacts}
        </h2>
        <p
            class="font-main text-[clamp(0.9rem,1.5vw,1.1rem)] text-extra-main leading-[1.6] max-w-[420px]"
        >
            {contacts.contact_message}
        </p>
        <a
            href={`mailto:${global.email}`}
            class="font-main text-[clamp(1rem,2vw,1.25rem)] font-bold text-accent-main px-[clamp(1rem,2vw,1.5rem)] py-[clamp(0.5rem,1vw,0.75rem)] border-2 border-accent-main rounded-[clamp(0.5rem,1vw,0.75rem)] transition-colors duration-200 hover:bg-accent-main hover:text-bg-main"
            >{global.email}</a
        >
    </div>

    <div
        class="flex flex-col items-center gap-[clamp(0.4rem,1vw,0.75rem)] px-[clamp(1.5rem,5vw,3rem)] py-[clamp(1.25rem,2.5vw,1.75rem)] border-t border-[rgba(242,196,176,0.2)] w-full box-border text-center"
    >
        <span
            class="font-accent text-[clamp(1.25rem,3vw,1.5rem)] text-accent-main"
            >Dulcețime</span
        >
        <span
            class="font-main text-[clamp(0.75rem,1.2vw,0.85rem)] text-extra-main opacity-60"
            >&copy; {new Date().getFullYear()} &lt;3</span
        >
    </div>
</footer>
