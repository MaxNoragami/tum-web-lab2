---
import { Image } from "astro:assets";

interface Props {
    id: string;
    ctaText: string;
}

const { id, ctaText } = Astro.props;
---

<button
    popovertarget={id}
    popovertargetaction="show"
    class="mascot-toggle-btn"
    aria-label={ctaText}
>
    <Image
        src="/uploads/icons/heart.svg"
        alt={ctaText}
        width={28}
        height={28}
        loading="eager"
    />
</button>
