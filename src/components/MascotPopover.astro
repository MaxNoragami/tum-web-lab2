---
import global from "../content/ro/global.json";
---

<div
    class="mascot-container animate-mascot-appear"
    id="mascot-popover"
    popover="manual"
>
    <a
        href="#build-your-own"
        class="mascot-container__cta animate-mascot-cta-combined"
        onclick="document.getElementById('mascot-popover').hidePopover()"
        >{global.cta_text}</a
    >
    <img
        src="mascot/main.png"
        alt="Mascot"
        class="mascot-img animate-mascot-img-jump"
    />
    <img
        src="mascot/secondary.png"
        alt="Spatula"
        class="mascot-secondary animate-mascot-secondary-jump"
    />
</div>
