---
import { Image } from "astro:assets";

interface Props {
    src: string;
    alt: string;
}

const { src, alt } = Astro.props;
---

<figure class="gallery__slide">
    <Image
        src={src}
        alt={alt}
        class="gallery__image"
        width={1200}
        height={900}
        loading="lazy"
    />
</figure>
